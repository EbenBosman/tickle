{
  "name": "tickle-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.54.0",
    "@fastify/cors": "^11.2.0",
    "fastify": "^5.8.5",
    "openai": "^6.36.0",
    "playwright": "^1.59.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "4.1.5",
    "eslint": "9.39.4",
    "globals": "17.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.1.5"
  }
}
