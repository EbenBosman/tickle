PORT=8787

# OpenAI-compatible LLM endpoint. Default points at LM Studio.
# Works with any OpenAI-compatible local server:
#   - LM Studio: http://127.0.0.1:1234/v1   ← default
#   - Ollama:    http://127.0.0.1:11434/v1
#   - vLLM, SGLang, llama.cpp server, etc.
LLM_BASE_URL=http://127.0.0.1:1234/v1

# Whatever model name your LLM server reports for the loaded model.
# The recommended default is an abliterated qwen3.6-27b — uncensored variants
# follow instructions about page content (forms, banners, refusals) without
# adding a second policy layer on top of the model already running locally.
LLM_MODEL=qwen3.6-27b-uncensored-hauhaucs-balanced

# Most local servers ignore the API key, but the OpenAI client always sends one.
LLM_API_KEY=not-needed

# Context window of the loaded model (must match the value you set in LM Studio
# / Ollama / vLLM). Used by the footer to show how full your prompt is.
LLM_CONTEXT_WINDOW=32768

HEADED=true
MAX_AGENT_STEPS=25
KEEP_RECENT_IMAGES=3

# Anthropic API key (required for Claude rescue feature).
# Get one at https://console.anthropic.com — billed separately from any Claude Max plan.
# Leave blank to disable rescue.
ANTHROPIC_API_KEY=
